---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog | Pu++">
  <Navbar />
  <main class="flex-grow max-w-7xl mx-auto px-4 py-12 w-full">
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-bold text-white mb-4">Blog & Noticias</h1>
      <p class="text-gray-400 max-w-2xl mx-auto">
        Mantente al día con las últimas novedades del club, resultados de concursos y anuncios
        importantes.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group bg-card-bg border border-gray-800 rounded-xl overflow-hidden hover:border-unam-blue transition-all hover:-translate-y-1"
          >
            {post.data.heroImage && (
              <div class="aspect-video w-full overflow-hidden">
                <img
                  src={post.data.heroImage}
                  alt=""
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
            )}
            <div class="p-6">
              <div class="flex gap-2 mb-3">
                {post.data.tags &&
                  post.data.tags
                    .slice(0, 2)
                    .map((tag) => (
                      <span class="text-xs font-bold text-unam-blue bg-blue-900/20 px-2 py-1 rounded uppercase">
                        {tag}
                      </span>
                    ))}
              </div>
              <h2 class="text-xl font-bold text-white mb-2 group-hover:text-unam-blue transition-colors">
                {post.data.title}
              </h2>
              <p class="text-gray-400 text-sm line-clamp-2 mb-4">{post.data.description}</p>
              <div class="text-xs text-gray-500 font-code">
                {post.data.pubDate.toLocaleDateString('es-MX', { dateStyle: 'long' })}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>
  <Footer />
</Layout>
