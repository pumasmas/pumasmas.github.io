---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Typewriter from '../components/React/Typewriter.jsx';
import TagBadge from '../components/TagBadge.astro';
import Terminal from '../components/Terminal.astro';
import {
  DIFFICULTY_COLORS,
  STATS,
  HOME_DESCRIPTION,
  FEATURES,
  SOCIAL_LINKS,
  TYPEWRITER_WORDS,
  TERMINAL_COMMANDS,
} from '../consts';
import { getLatestWikiEntries } from '../utils/wiki';

// Fetch latest 3 Wiki entries
const wikiEntries = await getLatestWikiEntries(3);
---

<Layout title="Pu++ | Club de Programación Competitiva UNAM">
  <Navbar />

  <main class="flex-grow">
    <!-- Hero Section -->
    <section class="relative min-h-[85vh] flex items-center justify-center overflow-hidden pt-16">
      <!-- Background Effects -->
      <div class="absolute inset-0 bg-bg-dark z-0">
        <!-- Grid Pattern -->
        <div
          class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:32px_32px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
        >
        </div>
        <!-- Gradient Glow -->
        <div
          class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-unam-blue/20 blur-[120px] rounded-full opacity-50"
        >
        </div>
      </div>

      <div class="relative z-10 container mx-auto px-4 grid lg:grid-cols-2 gap-12 items-center">
        <!-- Text Content -->
        <div class="text-center lg:text-left">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-unam-gold/10 border border-unam-gold/20 text-unam-gold text-xs font-code mb-6"
          >
            <span class="w-2 h-2 rounded-full bg-unam-gold animate-pulse"></span>
            FACULTAD DE CIENCIAS - UNAM
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
            Domina <br />
            <Typewriter client:visible words={TYPEWRITER_WORDS} />
          </h1>

          <p
            class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto lg:mx-0 mb-8 leading-relaxed"
          >
            {HOME_DESCRIPTION}
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a
              href="#join"
              class="group px-8 py-3.5 bg-unam-blue hover:bg-blue-600 text-white font-semibold rounded-lg transition-all shadow-lg shadow-unam-blue/25 flex items-center justify-center gap-2"
            >
              Unirme al Club
              <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
            </a>
            <a
              href="/wiki"
              class="px-8 py-3.5 bg-card-bg border border-gray-700 hover:border-unam-gold text-gray-300 hover:text-white font-code font-semibold rounded-lg transition-all"
            >
              $ cat wiki_intro
            </a>
          </div>
        </div>

        <!-- Visual Content (Terminal) -->
        <div class="hidden lg:block">
          <Terminal commands={TERMINAL_COMMANDS} />
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="py-12 border-y border-gray-800 bg-card-bg/50 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
          {
            STATS.map((stat) => (
              <div class="text-center group cursor-default">
                <h3 class="text-3xl md:text-4xl font-bold text-white mb-2 group-hover:text-unam-gold transition-colors">
                  {stat.prefix && (
                    <span class="text-lg md:text-xl font-medium mr-1 opacity-70">
                      {stat.prefix}
                    </span>
                  )}
                  {stat.value}
                  {stat.suffix && (
                    <span class="text-lg md:text-xl font-medium ml-1 opacity-70">
                      {stat.suffix}
                    </span>
                  )}
                </h3>
                <p class="font-code text-xs md:text-sm text-gray-500 uppercase tracking-wider">
                  {stat.label}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Latest Wiki Entries -->
    <section class="py-24 px-4 bg-bg-dark">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Recursos Recientes</h2>
            <p class="text-gray-400 max-w-xl">
              Mantente al día con las últimas guías y algoritmos agregados a nuestra base de
              conocimiento.
            </p>
          </div>
          <a
            href="/wiki"
            class="text-unam-blue hover:text-blue-400 font-semibold flex items-center gap-2 group"
          >
            Ver toda la Wiki
            <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            wikiEntries.map((entry) => (
              <a href={`/wiki/${entry.slug}`} class="group flex flex-col">
                <article class="flex-1 bg-card-bg border border-gray-800 rounded-xl p-6 hover:border-unam-gold/50 hover:shadow-lg hover:shadow-unam-gold/10 transition-all flex flex-col">
                  <div class="flex justify-between items-start mb-4">
                    <TagBadge text={entry.data.topic} type="topic" />
                    <TagBadge
                      text={entry.data.difficulty}
                      type="difficulty"
                      difficultyLevel={entry.data.difficulty as keyof typeof DIFFICULTY_COLORS}
                    />
                  </div>
                  <h3 class="text-xl font-bold text-white mb-2 group-hover:text-unam-blue transition-colors">
                    {entry.data.title}
                  </h3>
                  <p class="text-gray-400 text-sm line-clamp-3 mb-4 flex-grow">
                    {entry.data.description}
                  </p>
                  <div class="flex items-center text-xs text-gray-500 font-code pt-4 border-t border-gray-800/50">
                    <i class="fas fa-calendar-alt mr-2" />
                    {entry.data.lastUpdated
                      ? entry.data.lastUpdated.toLocaleDateString()
                      : 'Reciente'}
                  </div>
                </article>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section id="about" class="py-24 px-4 relative overflow-hidden">
      <!-- Background Decorations -->
      <div
        class="absolute top-1/2 left-0 -translate-y-1/2 w-64 h-64 bg-unam-gold/5 blur-[80px] rounded-full"
      >
      </div>

      <div class="max-w-7xl mx-auto relative z-10">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-16 text-white">
          ¿Por qué unirte?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            FEATURES.map((feature) => (
              <div class="bg-card-bg/80 backdrop-blur p-8 rounded-xl border border-gray-800 hover:border-unam-blue transition-all group hover:-translate-y-1">
                <div class="w-14 h-14 bg-card-bg rounded-lg flex items-center justify-center border border-gray-700 mb-6 group-hover:border-unam-blue group-hover:scale-110 transition-all shadow-lg">
                  <i class={`fas ${feature.icon} text-2xl text-unam-gold`} />
                </div>
                <h3 class="text-xl font-bold text-white mb-4">{feature.title}</h3>
                <p class="text-gray-400 leading-relaxed">{feature.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="join" class="py-20 px-4">
      <div
        class="max-w-5xl mx-auto bg-gradient-to-br from-unam-blue to-blue-900 rounded-2xl p-8 md:p-12 text-center shadow-2xl relative overflow-hidden"
      >
        <!-- Overlay Pattern -->
        <div
          class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white via-transparent to-transparent"
        >
        </div>

        <div class="relative z-10">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">¿Listo para competir?</h2>
          <p class="text-blue-100 text-lg mb-8 max-w-2xl mx-auto">
            Únete a nuestro servidor de Discord y comienza tu entrenamiento hoy mismo. No necesitas
            experiencia previa, solo ganas de aprender.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href={SOCIAL_LINKS.discord}
              target="_blank"
              class="px-8 py-3 bg-white text-unam-blue font-bold rounded-lg hover:bg-gray-100 transition-colors shadow-lg"
            >
              Unirse al Discord
            </a>
            <a
              href={`mailto:${SOCIAL_LINKS.email}`}
              class="px-8 py-3 bg-blue-800/50 text-white font-bold rounded-lg border border-blue-400/30 hover:bg-blue-800 transition-colors"
            >
              Contáctanos
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
