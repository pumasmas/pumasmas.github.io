---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Typewriter from '../components/React/Typewriter.jsx';

const stats = [
    { value: '70+', label: 'Miembros Activos' },
    { value: 'Top 8%', label: 'Regional ICPC 2025' },
    { value: 'Weekly', label: 'Simulaciones' }
];

const features = [
    {
        icon: 'fa-brain',
        title: 'Algoritmos Avanzados',
        desc: 'Domina Grafos, Programación Dinámica, Segment Trees y Geometría Computacional.'
    },
    {
        icon: 'fa-trophy',
        title: 'ICPC Training',
        desc: 'Simulaciones semanales con problemsets reales de regionales pasadas y Codeforces Gym.'
    },
    {
        icon: 'fa-code-branch',
        title: 'Comunidad Open Source',
        desc: 'Colabora en nuestros repositorios y mejora tus habilidades de Ingeniería de Software.'
    }
];
---

<Layout title="Pu++ | Club de Programación Competitiva UNAM">
    <Navbar />
    
    <main class="flex-grow">
        <!-- Hero Section -->
        <section class="relative h-[80vh] flex items-center justify-center text-center px-4 overflow-hidden">
            <!-- Background Gradient -->
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-unam-blue/10 via-bg-dark to-bg-dark z-0"></div>
            
            <div class="relative z-10 max-w-4xl mx-auto">
                <p class="text-unam-gold font-code text-sm md:text-base tracking-[0.2em] mb-4">FACULTAD DE CIENCIAS - UNAM</p>
                <h1 class="text-5xl md:text-7xl font-bold text-white mb-6 leading-tight">
                    Domina <br class="hidden md:block" />
                    <Typewriter client:visible words={["Algoritmos.", "Estructuras.", "el Código."]} />
                </h1>
                <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto mb-10">
                    Somos la comunidad oficial de entrenamiento para el <strong>ICPC</strong>. 
                    Resolvemos problemas complejos con soluciones eficientes.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="#join" class="px-8 py-3 bg-unam-blue hover:bg-blue-600 text-white font-semibold rounded-lg transition-all hover:-translate-y-1 shadow-lg shadow-unam-blue/20">
                        Unirme al Club
                    </a>
                    <a href="/wiki" class="px-8 py-3 bg-transparent border border-unam-gold text-unam-gold hover:bg-unam-gold/10 font-code font-semibold rounded-lg transition-all">
                        Explorar Wiki
                    </a>
                </div>
            </div>
        </section>

        <!-- Stats Section -->
        <section class="py-10 bg-card-bg border-y border-gray-800">
            <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-center gap-12 text-center">
                {stats.map(stat => (
                    <div>
                        <h3 class="text-3xl font-bold text-white mb-1">{stat.value}</h3>
                        <p class="font-code text-sm text-gray-500">{stat.label}</p>
                    </div>
                ))}
            </div>
        </section>

        <!-- About / Features Section -->
        <section id="about" class="py-24 px-4">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-16 text-white">Nuestro Enfoque</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    {features.map(feature => (
                        <div class="bg-card-bg p-8 rounded-xl border border-gray-800 hover:border-unam-blue transition-colors group">
                            <i class={`fas ${feature.icon} text-3xl text-unam-gold mb-6 group-hover:scale-110 transition-transform`}></i>
                            <h3 class="text-xl font-bold text-white mb-4">{feature.title}</h3>
                            <p class="text-gray-400 leading-relaxed">
                                {feature.desc}
                            </p>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
