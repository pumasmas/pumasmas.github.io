---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import WikiBrowser from '../../components/React/WikiBrowser.jsx';
import { getCollection } from 'astro:content';
import { DIFFICULTY_COLORS } from '../../consts';

const entries = await getCollection('wiki');
---

<Layout title="Wiki de Algoritmos | Pu++">
  <Navbar />
  <main class="flex-grow max-w-7xl mx-auto px-4 py-12 w-full">
    <div class="mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-text-bright mb-4">Wiki de Algoritmos</h1>
      <p class="text-text-muted text-lg max-w-2xl mx-auto">
        Nuestra base de conocimiento comunitaria. Desde estructuras de datos básicas hasta técnicas
        avanzadas.
      </p>
    </div>

    <!-- Interactive Wiki Browser -->
    <WikiBrowser client:load initialEntries={entries} difficultyColors={DIFFICULTY_COLORS} />
  </main>
  <Footer />
</Layout>
