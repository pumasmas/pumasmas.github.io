---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WikiSidebar from '../components/WikiSidebar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Prerequisites from '../components/Prerequisites.astro';
import RelatedProblems from '../components/RelatedProblems.astro';
import WikiNav from '../components/WikiNav.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'wiki'>['data'] & {
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
};

const { title, description, difficulty, topic, prerequisites, relatedProblems, slug, headings } =
  Astro.props;
---

<Layout title={`${title} | Wiki Pu++`}>
  <Navbar />

  <main class="flex-grow max-w-[90rem] mx-auto px-4 py-8 w-full flex flex-col lg:flex-row gap-8">
    <!-- Mobile Menu Toggle -->

    <div class="lg:hidden w-full">
      <button
        id="wiki-menu-toggle"
        class="w-full flex items-center justify-between px-4 py-3 bg-bg-surface border border-border rounded-lg text-text-bright font-semibold hover:border-border-hover transition-colors"
      >
        <span class="flex items-center gap-2">
          <i class="fas fa-list text-accent"></i>

          Explorar Temas
        </span>

        <i class="fas fa-chevron-right text-text-muted text-sm"></i>
      </button>
    </div>

    <!-- Mobile Drawer -->

    <div
      id="wiki-drawer"
      class="fixed inset-0 z-[60] transform -translate-x-full transition-transform duration-300 lg:hidden"
      aria-hidden="true"
    >
      <!-- Backdrop -->

      <div
        id="wiki-drawer-backdrop"
        class="absolute inset-0 bg-black/80 backdrop-blur-sm opacity-0 transition-opacity duration-300"
      >
      </div>

      <!-- Drawer Content -->

      <aside
        class="relative w-4/5 max-w-sm h-full bg-bg-base border-r border-border flex flex-col shadow-2xl"
      >
        <div class="flex items-center justify-between p-4 border-b border-border">
          <span class="font-bold text-text-bright text-lg">Índice</span>

          <button
            id="wiki-drawer-close"
            class="p-2 text-text-muted hover:text-text-bright hover:bg-border rounded-lg transition-colors"
          >
            <i class="fas fa-times text-xl"></i>
          </button>
        </div>

        <div class="flex-1 overflow-y-auto p-4 custom-scrollbar">
          <WikiSidebar currentSlug={slug} />
        </div>
      </aside>
    </div>

    <!-- Desktop Sidebar -->

    <aside class="hidden lg:block w-64 flex-shrink-0">
      <div class="sticky top-24 max-h-[calc(100vh-6rem)] overflow-y-auto pr-4 custom-scrollbar">
        <WikiSidebar currentSlug={slug} />
      </div>
    </aside>

    <article class="flex-grow min-w-0 max-w-4xl">
      <Breadcrumbs currentTitle={title} />

      <div class="mb-8 pb-6 border-b border-border">
        <div class="flex items-center gap-4 mb-4">
          <TagBadge text={topic} type="topic" href="/wiki" />
          <TagBadge text={difficulty} type="difficulty" difficultyLevel={difficulty} href="/wiki" />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-text-bright mb-4 leading-tight">{title}</h1>
        <p class="text-xl text-text-muted leading-relaxed">{description}</p>
      </div>

      {prerequisites && <Prerequisites slugs={prerequisites} />}

      <div class="prose prose-invert prose-lg max-w-none">
        <slot />
      </div>

      {relatedProblems && <RelatedProblems problems={relatedProblems} />}

      <WikiNav currentSlug={slug} topic={topic} />
    </article>

    <TableOfContents headings={headings} />
  </main>
  <Footer />
  <script src="../scripts/copy-code.js"></script>

  <script>
    document.addEventListener('astro:page-load', () => {
      const toggleBtn = document.getElementById('wiki-menu-toggle');
      const closeBtn = document.getElementById('wiki-drawer-close');
      const drawer = document.getElementById('wiki-drawer');
      const backdrop = document.getElementById('wiki-drawer-backdrop');

      function openDrawer() {
        if (drawer && backdrop) {
          drawer.classList.remove('-translate-x-full');
          drawer.setAttribute('aria-hidden', 'false');
          backdrop.classList.remove('opacity-0');
          document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }
      }

      function closeDrawer() {
        if (drawer && backdrop) {
          drawer.classList.add('-translate-x-full');
          drawer.setAttribute('aria-hidden', 'true');
          backdrop.classList.add('opacity-0');
          document.body.style.overflow = '';
        }
      }

      toggleBtn?.addEventListener('click', openDrawer);
      closeBtn?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);
    });
  </script>
</Layout>
