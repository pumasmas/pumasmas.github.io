---
interface Command {
  text: string;
  output?: string[];
  isSuccess?: boolean;
}

interface Props {
  user?: string;
  machine?: string;
  dir?: string;
  commands: Command[];
}

const { user = 'user', machine = 'pumasmas', dir = '~/contest', commands } = Astro.props;
---

<div class="relative group perspective-1000">
  <div
    class="absolute -inset-1 bg-gradient-to-r from-accent via-primary to-purple-600 rounded-xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"
  >
  </div>
  <div
    class="relative rounded-xl bg-[#0d1117] border border-border shadow-2xl overflow-hidden transform transition-transform group-hover:rotate-1"
  >
    <!-- Terminal Header -->
    <div class="flex items-center justify-between px-4 py-3 bg-[#161b22] border-b border-border">
      <div class="flex gap-2">
        <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
        <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
      </div>
      <div class="text-xs text-text-muted font-code">{user}@{machine}:{dir}</div>
      <div class="w-12"></div>
    </div>
    <!-- Terminal Body -->
    <div class="p-6 font-code text-sm md:text-base space-y-2">
      {
        commands.map((cmd) => (
          <div class="space-y-1">
            <div class="flex">
              <span class="text-accent mr-2">➜</span>
              <span class="text-cyan-400">~</span>
              <span class="text-text-muted ml-2">{cmd.text}</span>
            </div>
            {cmd.output && (
              <div class="text-text-base pt-1">
                {cmd.output.map((line) => (
                  <Fragment set:html={line + '<br />'} />
                ))}
              </div>
            )}
            {cmd.isSuccess && (
              <div class="pt-2 text-green-400 font-bold">
                <i class="fas fa-check-circle mr-2" />
                Accepted (15ms, 2048KB)
              </div>
            )}
          </div>
        ))
      }
      <div class="flex pt-2 animate-pulse">
        <span class="text-accent mr-2">➜</span>
        <span class="text-cyan-400">~</span>
        <span class="w-2 h-5 bg-gray-500 ml-2"></span>
      </div>
    </div>
  </div>
</div>
