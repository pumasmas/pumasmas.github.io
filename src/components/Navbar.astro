---
import { NAV_LINKS } from '../consts';
import GlobalSearch from './React/GlobalSearch.jsx';
import { getCollection } from 'astro:content';

const searchEntries = await getCollection('wiki');
---

<nav class="sticky top-0 z-50 w-full backdrop-blur-md bg-bg-dark/90 border-b border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex-shrink-0">
        <a href="/" class="font-code font-bold text-2xl text-text-bright">
          Pu<span class="text-unam-gold">++</span>
        </a>
      </div>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center gap-6">
        <GlobalSearch client:idle entries={searchEntries} />

        <div class="flex items-baseline space-x-6">
          {
            NAV_LINKS.map((link) => (
              <a
                href={link.href}
                class="text-text-main hover:text-unam-blue px-3 py-2 rounded-md text-sm font-semibold transition-colors duration-200"
              >
                {link.name}
              </a>
            ))
          }
          <a
            href="https://github.com/pumasmas"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-gray-800 hover:bg-gray-700 text-white px-4 py-2 rounded-md text-sm font-semibold transition-colors duration-200 flex items-center gap-2"
          >
            <i class="fab fa-github"></i> GitHub
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center gap-4 md:hidden">
        <GlobalSearch client:idle entries={searchEntries} />

        <button
          id="mobile-menu-button"
          type="button"
          class="bg-gray-800 inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-white hover:bg-gray-700 focus:outline-none"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <i class="fas fa-bars" id="menu-icon"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="hidden md:hidden bg-bg-dark border-b border-gray-800" id="mobile-menu">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-text-main hover:text-unam-blue block px-3 py-2 rounded-md text-base font-semibold transition-colors duration-200"
          >
            {link.name}
          </a>
        ))
      }
      <a
        href="https://github.com/pumasmas"
        target="_blank"
        rel="noopener noreferrer"
        class="text-text-main hover:text-unam-blue block px-3 py-2 rounded-md text-base font-semibold transition-colors duration-200"
      >
        GitHub
      </a>
    </div>
  </div>
</nav>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const icon = document.getElementById('menu-icon');

  if (button && menu && icon) {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');

      // Toggle icons
      icon.classList.toggle('fa-bars');
      icon.classList.toggle('fa-times');
    });

    // Close menu when clicking a link
    const links = menu.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        icon.classList.add('fa-bars');
        icon.classList.remove('fa-times');
      });
    });
  }
</script>
