---
import { FEATURES } from '../../consts';
---

<section id="about" class="py-24 px-4 relative overflow-hidden">
  <!-- Background Decorations -->
  <div
    class="absolute top-1/2 left-0 -translate-y-1/2 w-64 h-64 bg-accent/5 blur-[80px] rounded-full"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-16 text-text-bright">
      ¿Por qué unirte?
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        FEATURES.map((feature) => (
          <div class="bg-bg-surface/80 backdrop-blur p-8 rounded-xl border border-border hover:border-border-hover transition-all group hover:-translate-y-1">
            <div class="w-14 h-14 bg-bg-surface rounded-lg flex items-center justify-center border border-border mb-6 group-hover:border-border-hover group-hover:scale-110 transition-all shadow-lg">
              <i class={`fas ${feature.icon} text-2xl text-accent`} />
            </div>
            <h3 class="text-xl font-bold text-text-bright mb-4">{feature.title}</h3>
            <p class="text-text-muted leading-relaxed">{feature.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
