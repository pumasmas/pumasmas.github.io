---
import { getCollection } from 'astro:content';

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;

// Fetch all wiki entries to look up titles
const allEntries = await getCollection('wiki');
const prerequisites = slugs
  .map((slug) => {
    const entry = allEntries.find((e) => e.slug === slug);
    return entry ? { slug: entry.slug, title: entry.data.title } : null;
  })
  .filter((e): e is { slug: string; title: string } => e !== null);

if (prerequisites.length === 0) {
  return null;
}
---

<div
  class="mb-6 p-4 bg-gray-900/50 border border-l-4 border-border border-l-unam-blue rounded-r-lg"
>
  <h3
    class="text-sm font-bold text-text-muted uppercase tracking-wider mb-2 flex items-center gap-2"
  >
    <i class="fas fa-layer-group"></i> Prerrequisitos
  </h3>
  <ul class="flex flex-wrap gap-2">
    {
      prerequisites.map((prereq) => (
        <li>
          <a
            href={`/wiki/${prereq.slug}`}
            class="inline-block px-3 py-1 bg-primary/10 text-primary hover:bg-primary hover:text-text-bright rounded-full text-sm font-medium transition-colors"
          >
            {prereq.title}
          </a>
        </li>
      ))
    }
  </ul>
</div>
