---
import { NAV_LINKS } from '../consts';
---
<footer class="bg-card-bg border-t border-gray-800 mt-auto">
    <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-8">
            <div class="text-center md:text-left">
                <p class="text-base text-gray-400 font-bold mb-2">Pu++ UNAM</p>
                <p class="text-sm text-gray-500">
                    Facultad de Ciencias, UNAM.
                </p>
            </div>
            
            <div class="flex flex-wrap justify-center gap-6">
                {NAV_LINKS.map(link => (
                    <a href={link.href} class="text-sm text-gray-500 hover:text-unam-gold transition-colors">
                        {link.name}
                    </a>
                ))}
                <a href="https://github.com/pumasmas" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-500 hover:text-white">
                    GitHub
                </a>
            </div>

            <div class="text-center md:text-right">
                <p class="text-sm text-gray-500">
                    &copy; {new Date().getFullYear()} Hecho con <i class="fas fa-code text-unam-blue"></i> por el equipo Pu++.
                </p>
            </div>
        </div>
    </div>
</footer>
