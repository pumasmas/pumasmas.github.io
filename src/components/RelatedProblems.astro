---
interface Props {
  problems: {
    name: string;
    url: string;
    platform: string;
  }[];
}

const { problems } = Astro.props;

if (!problems || problems.length === 0) {
  return null;
}

const getPlatformIcon = (platform: string) => {
    const p = platform.toLowerCase();
    if (p.includes('codeforces')) return 'fas fa-chart-bar'; // Placeholder
    if (p.includes('leetcode')) return 'fas fa-code';
    if (p.includes('atcoder')) return 'fas fa-trophy';
    return 'fas fa-external-link-alt';
};
---

<div class="mt-12 pt-8 border-t border-gray-800">
  <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
    <i class="fas fa-dumbbell text-unam-gold"></i>
    Problemas Relacionados
  </h2>
  <div class="grid gap-4 sm:grid-cols-2">
    {problems.map(problem => (
      <a 
        href={problem.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between p-4 bg-card-bg border border-gray-800 rounded-xl hover:border-unam-gold/50 hover:bg-gray-800 transition-all group"
      >
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-gray-900 flex items-center justify-center text-gray-400 group-hover:text-unam-gold transition-colors">
                <i class={getPlatformIcon(problem.platform)}></i>
            </div>
            <div>
                <div class="font-medium text-white group-hover:text-unam-gold transition-colors">
                    {problem.name}
                </div>
                <div class="text-xs text-gray-500">
                    {problem.platform}
                </div>
            </div>
        </div>
        <i class="fas fa-chevron-right text-gray-600 group-hover:text-white transition-colors"></i>
      </a>
    ))}
  </div>
</div>
